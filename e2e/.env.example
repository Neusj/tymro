# === TYMRO E2E — variables de entorno ===
# Copia este archivo a `.env` y completa los valores. NUNCA comitees `.env`.

# --- URLs de QA ---
QA_BASE_URL=https://qa.tymroapp.com
# API: normalmente base + /api. Si lo dejas vacío se deriva de QA_BASE_URL.
QA_API_URL=https://qa.tymroapp.com/api

# --- Alumno feliz (es USERNAME, no email) ---
QA_USER=student1
QA_PASSWORD=student123

# --- Gym admin (para generar el token QR vivo) ---
QA_GYM_ADMIN_USER=gymadmin
QA_GYM_ADMIN_PASSWORD=gymadmin123

# --- Organización a seedear/probar ---
QA_ORG_SLUG=r2b-qa

# --- Seed automático antes de la suite ---
# Comando que repuebla QA. Se ejecuta en global-setup desde la raíz del repo.
# Déjalo vacío (o QA_SKIP_SEED=1) si prefieres seedear tú a mano.
QA_SEED_CMD=docker compose exec -T backend python manage.py seed_demo_data --org=r2b-qa
# QA_SKIP_SEED=1

# --- Overrides opcionales ---
# Si los defines, tienen prioridad sobre lo que imprime el seed (.fixtures.json).
# QA_FOREIGN_CLASS_ID=
# QA_FOREIGN_ORG_ID=
