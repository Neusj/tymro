# Regenéralo en el dashboard de Cloudflare. NO lo dejes commiteado en texto plano.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_DOMAIN=tymroapp.com
# Dominio base que define las tres superficies:
#   <BASE_DOMAIN>              -> landing publica
#   app.<BASE_DOMAIN>          -> app administrativa general
#   <organizacion>.<BASE_DOMAIN> -> app de organizacion
# Desarrollo local: BASE_DOMAIN=localhost.
# Produccion: BASE_DOMAIN=tymroapp.com.
BASE_DOMAIN=localhost
VITE_PUBLIC_BASE_DOMAIN=localhost
VITE_APP_SUBDOMAIN=app
# Opcional. Si queda vacio, la landing arma <protocolo>://app.<VITE_PUBLIC_BASE_DOMAIN>[:puerto].
VITE_APP_URL=
VITE_CONTACT_URL=
VITE_CONTACT_EMAIL=contacto@tymroapp.com
VITE_CONTACT_WHATSAPP=
VITE_TYMRO_START_PRICE=
VITE_TYMRO_PRO_PRICE=
VITE_TYMRO_MAX_PRICE=
VITE_SOCIAL_WHATSAPP_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_YOUTUBE_URL=

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Genera uno fuerte:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# En producción (DEBUG=False) la app NO arranca si SECRET_KEY está vacía.
SECRET_KEY=pon-aqui-un-secret-fuerte
# En producción: ambas en False.
DJANGO_DEBUG=False
DEBUG=False

# PostgreSQL externo. Usa DATABASE_URL o las variables separadas.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Fallback local si no configuras PostgreSQL.
SQLITE_DB_NAME=/data/db.sqlite3

ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,tymroapp.com,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tymroapp.com,https://*.trycloudflare.com
# En producción: False. La lista explícita de CORS_ALLOWED_ORIGINS es la que manda.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tymroapp.com

# Caducidad del token de sesión DRF (horas). El token se rota al re-loguear.
TOKEN_TTL_HOURS=12

# Email. En dev (DEBUG=True) sale por consola. En producción usa Resend por API
# HTTPS (django-anymail): setear RESEND_API_KEY. El remitente sale de DEFAULT_FROM_EMAIL
# y debe estar en un dominio verificado en Resend.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@tymroapp.com
# Base usada para armar el link de reset que va en el email.
FRONTEND_URL=https://tymroapp.com
# Validez del enlace de reset, en segundos (default 3 días).
PASSWORD_RESET_TIMEOUT=259200

VITE_API_URL=/api
