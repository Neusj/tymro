# Regenéralo en el dashboard de Cloudflare. NO lo dejes commiteado en texto plano.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_DOMAIN=tymroapp.com

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Genera uno fuerte:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# En producción (DEBUG=False) la app NO arranca si SECRET_KEY está vacía.
SECRET_KEY=pon-aqui-un-secret-fuerte
# En producción: ambas en False.
DJANGO_DEBUG=False
DEBUG=False

# PostgreSQL externo. Usa DATABASE_URL o las variables separadas.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Fallback local si no configuras PostgreSQL.
SQLITE_DB_NAME=/data/db.sqlite3

ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,tymroapp.com,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tymroapp.com,https://*.trycloudflare.com
# En producción: False. La lista explícita de CORS_ALLOWED_ORIGINS es la que manda.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tymroapp.com

# Caducidad del token de sesión DRF (horas). El token se rota al re-loguear.
TOKEN_TTL_HOURS=12

# Email (reset de contraseña). En dev (DEBUG=True) sale por consola.
# En producción carga credenciales SMTP reales (Gmail/SendGrid/etc.).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@tymroapp.com
# Base usada para armar el link de reset que va en el email.
FRONTEND_URL=https://tymroapp.com
# Validez del enlace de reset, en segundos (default 3 días).
PASSWORD_RESET_TIMEOUT=259200

VITE_API_URL=/api
