# Contexto de build = raíz del repo. Mantener la imagen limpia y sin secretos.
.git
.gitignore
.codex-predeploy-basetemp
.codex-pytest*
.codex-tmp*
.pytest-cache-local
.pytest-tmp*
pytest-tmp*
**/.env
**/.env.*
!**/.env.example
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.pytest-cache-local/
**/.pytest-tmp*/
**/pytest-tmp*/
**/.codex-predeploy-basetemp/
**/.codex-pytest*/
**/.codex-tmp*/
backend/.codex-predeploy-basetemp
backend/.codex-pytest*
backend/.codex-tmp*
backend/.pytest-cache-local
backend/.pytest-tmp*
backend/pytest-tmp*
**/.coverage
**/.testmondata
**/.DS_Store

# El frontend se reconstruye dentro de la imagen.
**/node_modules/
frontend/dist/

# Artefactos de backend que no deben viajar a prod.
backend/staticfiles/
backend/db.sqlite3
backend/media/

# Solo dev / docs.
docker-compose.yml
README*.md
**/CLAUDE.MD
.claude/
