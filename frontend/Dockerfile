FROM node:20-alpine AS build

WORKDIR /app/frontend

COPY package*.json ./
RUN npm ci

COPY . .
ARG VITE_API_URL=/api
ARG VITE_PUBLIC_BASE_DOMAIN
ARG VITE_APP_SUBDOMAIN=app
ARG VITE_APP_URL
ARG VITE_CONTACT_URL
ARG VITE_CONTACT_EMAIL
ARG VITE_CONTACT_WHATSAPP
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PUBLIC_BASE_DOMAIN=$VITE_PUBLIC_BASE_DOMAIN
ENV VITE_APP_SUBDOMAIN=$VITE_APP_SUBDOMAIN
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_CONTACT_URL=$VITE_CONTACT_URL
ENV VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL
ENV VITE_CONTACT_WHATSAPP=$VITE_CONTACT_WHATSAPP
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
